# ==========================================================================
# Node / npm
# ==========================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ==========================================================================
# Playwright — звіти, артефакти прогонів, кеш браузерів
# ==========================================================================
# HTML-звіт (npx playwright show-report читає саме цю папку — не комітимо,
# бо вона перегенеровується щоразу і роздуває репозиторій, як свого часу
# траплялось з mochawesome-звітами в Cypress-проєкті).
playwright-report/

# "Сирі" результати прогону: скріншоти/відео/трейси на впалих тестах
# (screenshot: 'only-on-failure', video: 'retain-on-failure', trace:
# 'on-first-retry' з playwright.config.js записують сюди).
test-results/

# blob-звіти (використовуються при шардингу тестів у CI, --reporter=blob).
blob-report/

# Кеш самого Playwright (метадані завантажених браузерів тощо).
playwright/.cache/

# Локально встановлені браузерні бінарники Chromium/Firefox/WebKit
# (якщо раптом встановлені не в стандартну системну теку, а в проєкт).
playwright-browsers/

# Trace-файли, відкриті вручну через `npx playwright show-trace`.
*.trace.zip

# ==========================================================================
# Авторизація / збережений стан сесії
# ==========================================================================
# storageState (cookies/localStorage залогіненого юзера) — часто зберігають
# як playwright/.auth/user.json, щоб не логінитись у кожному тесті наново.
# Це чутливі дані (сесійні токени) — в репозиторій не йдуть.
playwright/.auth/
**/.auth/
storageState.json

# ==========================================================================
# Змінні середовища / секрети
# ==========================================================================
# BASE_URL, логіни/паролі тестових юзерів, API-ключі тощо — усе, що зараз
# у HW 22.1 передавалось як cy.env(), у Playwright зазвичай лежить у .env
# і підключається через dotenv. Реальний .env — тільки локально.
.env
.env.*
!.env.example
.env.local
.env.*.local
.env.test


# ==========================================================================
# Звіти інших репортерів (якщо додаватимеш allure/junit пізніше)
# ==========================================================================
allure-results/
allure-report/
junit-results/
*.xml.tmp

# ==========================================================================
# Покриття коду (якщо колись підключиш nyc/c8 поверх Playwright)
# ==========================================================================
coverage/
.nyc_output/

# ==========================================================================
# TypeScript (актуально, якщо пізніше перейдеш з JS на TS)
# ==========================================================================
*.tsbuildinfo
dist/
build/

# ==========================================================================
# Логи
# ==========================================================================
logs/
*.log

# ==========================================================================
# IDE / редактори
# ==========================================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ==========================================================================
# ОС-специфічні файли
# ==========================================================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================================================
# Тимчасові файли завантажень (якщо тести перевіряють download через
# page.waitForEvent('download') і зберігають файл локально для перевірки)
# ==========================================================================
downloads/
tmp/
